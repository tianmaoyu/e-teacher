# ============================================================
#  SpeakMate Gateway 配置
#  复制为 .env 后按需修改。.env 已被 .gitignore 排除，不要提交。
# ============================================================

# ---- 服务 ----
PORT=8787
HOST=127.0.0.1
DATA_DIR=./data

# ---- 上游（OpenAI）----
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx
UPSTREAM_LIVE_URL=wss://api.openai.com/v1/live/sessions
UPSTREAM_API_BASE=https://api.openai.com/v1
LIVE_MODEL=gpt-live-1
BACKEND_MODEL=gpt-5.6-luna
TRANSLATE_MODEL=gpt-5.6-luna

# ---- 计费（成本 X 倍率 = 零售，单位 USD / 微美元）----
# 语音层成本：GPT-Live-1 官方价 $0.05 / 分钟
VOICE_COST_PER_MIN_USD=0.05
# 后端文本模型成本（翻译等），$ / 1K tokens
BACKEND_COST_PER_1K_TOK_USD=0.0008
# 零售倍率。毛利率 = (MARKUP-1)/MARKUP
MARKUP=3.0
# 人民币折算汇率
USD_CNY=7.2

# ---- 风控 ----
# 低于该秒数不允许建立会话
MIN_START_BALANCE_SEC=30
# 单次会话硬上限（秒）
MAX_SESSION_SEC=1800
# 单账号并发会话数
MAX_CONCURRENT_PER_ACCOUNT=1
# 客户端 instructions 最大字符数
MAX_CLIENT_INSTRUCTIONS=2000
# 建连后等待 session.start 的秒数
SESSION_START_TIMEOUT_SEC=20

# ---- 管理后台 ----
# 生产环境务必改成 32 位以上随机串：openssl rand -hex 32
ADMIN_TOKEN=change-me-admin-token
# 令牌哈希盐，一旦上线不要更换（更换会导致所有用户令牌失效）
TOKEN_SALT=change-me-token-salt

# ---- CORS ----
ALLOWED_ORIGIN=*
